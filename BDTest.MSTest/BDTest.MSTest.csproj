<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>BDTest.MSTest</PackageId>
        <Title>BDTest - MSTest</Title>
        <Description>An MSTest Extension for BDTest</Description>
        <PackageTags>test tdd bdd testing given when then mstest</PackageTags>
        <TargetFramework>netstandard2.0</TargetFramework>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BDTest\BDTest.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    </ItemGroup>

</Project>
