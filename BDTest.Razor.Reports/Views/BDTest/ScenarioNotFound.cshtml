@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models.ViewModels
@model BDTest.Maps.BDTestOutputModel
@{
    var run = (ReportLayoutViewModel)ViewData[nameof(ReportLayoutViewModel)];
    ViewBag.Title = "Scenario not found";
    ViewData["RunTab"] = "scenarios";
    Layout = "_Layout";
    var reportUrl = Url.Content("~/bdtest/report/" + Uri.EscapeDataString(Model.Id ?? string.Empty));
    var started = run.Timer.TestsStartedAt;
}

@await Html.PartialAsync("_RunHeader", run)

<main class="wrap page">
    <section class="card empty">
        <span class="mark">@ReportUi.Icon("i-doc", "xl")</span>
        <h2>Scenario not found in this run</h2>
        <p>
            @(started == default ? "This run is here" : $"The run from {started.ToRunDate(includeYear: false)} is here"),
            but it has no scenario with this ID. It may have been renamed.
        </p>
        <div class="cluster">
            <a class="btn pri" href="@reportUrl/all-scenarios">Search this run</a>
            <a class="btn" href="@reportUrl/summary">Run overview</a>
        </div>
    </section>
</main>
