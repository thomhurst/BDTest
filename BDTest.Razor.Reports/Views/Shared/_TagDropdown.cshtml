@using BDTest.Razor.Reports.Constants
@using BDTest.Razor.Reports.Helpers
@model IEnumerable<string>
@{
    var selectedTag = Context.Request.GetQueryParameter(TagConstants.FilterByTagQueryParameterName);
    var tags = Model.Append(selectedTag).Where(tag => !string.IsNullOrWhiteSpace(tag))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase);
}
<form method="get" action="@Context.Request.PathBase.Add(Context.Request.Path).ToUriComponent()" class="d-flex align-items-center gap-2 mx-2">
    @foreach (var parameter in Context.Request.Query)
    {
        if (string.Equals(parameter.Key, TagConstants.FilterByTagQueryParameterName, StringComparison.OrdinalIgnoreCase)
            || string.Equals(parameter.Key, PagerQueryParameters.Page, StringComparison.OrdinalIgnoreCase)
            || string.Equals(parameter.Key, "scenarioId", StringComparison.OrdinalIgnoreCase))
        {
            continue;
        }
        foreach (var value in parameter.Value)
        {
            <input type="hidden" name="@parameter.Key" value="@value" />
        }
    }
    <label for="tag-filter">Tag</label>
    <select id="tag-filter" name="@TagConstants.FilterByTagQueryParameterName" class="form-select">
        <option value="">All tags</option>
        @foreach (var tag in tags)
        {
            <option value="@tag" selected="@(string.Equals(tag, selectedTag, StringComparison.OrdinalIgnoreCase))">@tag</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Apply</button>
</form>
