<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DefineConstants>$(DefineConstants);BDTEST_XUNIT</DefineConstants>
        <OutputType>Exe</OutputType>

        <IsPackable>false</IsPackable>

        <SignAssembly>True</SignAssembly>

        <AssemblyOriginatorKeyFile>..\StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BDTest.xUnit\BDTest.xUnit.csproj" />
      <Compile Include="..\TestUtilities\LifecycleContract.cs" Link="Helpers\LifecycleContract.cs" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\AdapterConformanceTests.cs" Link="Conformance\AdapterConformanceTests.cs" />
    <Compile Include="..\TestUtilities\MethodIdentityContract.cs" Link="Helpers\MethodIdentityContract.cs" />
  </ItemGroup>
</Project>
