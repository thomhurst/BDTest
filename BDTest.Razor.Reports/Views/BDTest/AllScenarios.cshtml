@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Test
@model IGrouping<string, Scenario>[]
@{
    var run = (ReportLayoutViewModel)ViewData[nameof(ReportLayoutViewModel)];
    ViewBag.Title = run.Title + " scenarios";
    ViewData["RunTab"] = "scenarios";
    Layout = "_Layout";
    var list = ScenarioListBuilder.Build(Model, run.Scenarios, run.Report.Id, Context.Request, groupFixed: false);
}

@await Html.PartialAsync("_RunHeader", run)

<main class="wrap page tight">
    @await Html.PartialAsync("_ScenarioList", list)
</main>
