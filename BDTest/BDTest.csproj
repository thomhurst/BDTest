<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BDTest</PackageId>
    <Title>BDTest - A Behaviour Driven Testing Framework</Title>
    <Description>A Behaviour Driven Testing Framework</Description>
    <PackageTags>test tdd bdd testing given when then</PackageTags>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeStepMetadataGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>BDTest</RootNamespace>
    <ApplicationIcon />
    <StartupObject />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'netstandard2.0'" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Condition="'$(TargetFramework)' == 'netstandard2.0'" Version="4.6.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BDTest.CompilerShared\NamedStepTemplate.cs" Link="Helpers\NamedStepTemplate.cs" />
    <ProjectReference Include="..\BDTest.Contracts\BDTest.Contracts.csproj" />
    <ProjectReference Include="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <InternalsVisibleTo Include="BDTest.Tests" Key="$(BDTestPublicKey)" />
  </ItemGroup>

  <!-- Add the shared compiler payload once, from the legacy target. Query its evaluated
       output path to support NoBuild and custom output roots without a runtime dependency. -->
  <Target Name="IncludeStepMetadataGenerator" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <MSBuild Projects="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
             RemoveProperties="TargetFrameworks;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_StepMetadataGenerator" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_StepMetadataGenerator)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
