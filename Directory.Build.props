<Project>
 <PropertyGroup>
  <LangVersion>latest</LangVersion>
  <ImplicitUsings>enable</ImplicitUsings>
  <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
 </PropertyGroup>
 <!-- Runtime packages retain their existing strong-name identity. Compiler extensions
      stay unsigned; only the test assembly with friend access needs signing. -->
 <PropertyGroup>
  <BDTestPublicKey></BDTestPublicKey>
  <SignAssembly>false</SignAssembly>
  <SignAssembly Condition="'$(MSBuildProjectName)' == 'BDTest' Or '$(MSBuildProjectName)' == 'BDTest.NUnit' Or '$(MSBuildProjectName)' == 'BDTest.xUnit' Or '$(MSBuildProjectName)' == 'BDTest.MSTest' Or '$(MSBuildProjectName)' == 'BDTest.TUnit' Or '$(MSBuildProjectName)' == 'BDTest.Razor.Reports' Or '$(MSBuildProjectName)' == 'BDTest.Tests'">true</SignAssembly>
  <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true'">$(MSBuildThisFileDirectory)StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
 </PropertyGroup>
 <!-- Strict diagnostics for non-shipping code and Roslyn packages. See BUILDING.md. -->
 <!-- The core NUnit and report suites are tracked by #922 and #921 respectively. -->
 <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BDTest.Tests'
                          And '$(MSBuildProjectName)' != 'BDTest.ReportGenerator.Tests'
                          And ($([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '(?i)Tests|Pipeline|Example|ReportGenerator'))
                               Or '$(MSBuildProjectName)' == 'BDTest.SourceGenerator'
                               Or '$(MSBuildProjectName)' == 'BDTest.Analyzers')">
  <Nullable>enable</Nullable>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
 </PropertyGroup>
 <!-- Match the library projects selected by PackProjectsModule. -->
 <PropertyGroup Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '(?i)Tests|Pipeline|Example|ReportGenerator'))">
  <Authors>Tom Longhurst</Authors>
  <Copyright>Copyright ©2021 Tom Longhurst</Copyright>
  <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  <PackageIcon>nuget_icon.png</PackageIcon>
  <PackageProjectUrl>https://github.com/thomhurst/BDTest</PackageProjectUrl>
  <RepositoryUrl>https://github.com/thomhurst/BDTest</RepositoryUrl>
  <!-- Source Link is supplied by the .NET SDK (8 and later). -->
  <PublishRepositoryUrl>true</PublishRepositoryUrl>
  <EmbedUntrackedSources>true</EmbedUntrackedSources>
  <Deterministic>true</Deterministic>
  <DebugType>portable</DebugType>
  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  <!-- Existing APIs are only partially documented; still ship the available documentation. -->
  <NoWarn>$(NoWarn);CS1591</NoWarn>
  <!-- Validate runtime API compatibility across package assets during every pipeline pack.
       Compiler extensions have analyzer assets rather than runtime reference assemblies. -->
  <EnablePackageValidation Condition="'$(MSBuildProjectName)' != 'BDTest.SourceGenerator' And '$(MSBuildProjectName)' != 'BDTest.Analyzers'">true</EnablePackageValidation>
  <IncludeSymbols>true</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
 </PropertyGroup>
 <ItemGroup Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '(?i)Tests|Pipeline|Example|ReportGenerator'))">
  <None Include="$(MSBuildThisFileDirectory)nuget_icon.png" Pack="true" PackagePath="" />
 </ItemGroup>
</Project>
