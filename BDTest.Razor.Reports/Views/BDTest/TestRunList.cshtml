@using BDTest.Razor.Reports.Constants
@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models
@using BDTest.Test
@model IEnumerable<BDTest.Razor.Reports.Models.TestRunSummary>
@inject BDTestReportServerOptions BDTestReportServerOptions

@{
    ViewBag.Title = "Test runs";
    Layout = "_Layout";
    var isAdmin = await BDTestReportServerOptions.AdminAuthorizer.IsAdminAsync(Context);

    var allRuns = (Model ?? Enumerable.Empty<TestRunSummary>()).Where(run => run != null).ToList();
    var filter = RunFilter.FromQuery(Context.Request.Query);
    var runs = filter.Apply(allRuns).OrderByDescending(run => run.StartedAtDateTime).ToArray();

    var pageSizes = new[] { 25, 50, 100 };
    var pageSize = int.TryParse(Context.Request.GetQueryParameter("perPage"), out var perPage) && pageSizes.Contains(perPage) ? perPage : 25;
    var pager = new Pager<TestRunSummary>(runs, Context.GetCurrentPageNumber(), pageSize);
    var pagination = pager.GetPaginationInformation();
    pagination.ItemName = filter.Tag == null ? "runs" : filter.Tag + " runs";
    pagination.PreviousText = "Newer";
    pagination.NextText = "Older";
    pagination.PageSizeOptions = pageSizes;
    pagination.PageSize = pageSize;

    var path = Url.Content("~/bdtest/report/test-runs");
    var today = DateTime.UtcNow.Date;

    string Query(RunFilter value)
    {
        var pairs = value.ToQuery().Where(pair => pair.Key != "range" || pair.Value != RunFilter.AnyTime).ToList();
        if (pageSize != 25)
        {
            pairs.Add(new KeyValuePair<string, string>("perPage", pageSize.ToString()));
        }

        return path + RunFilter.ToQueryString(pairs);
    }

    RunFilter With(Action<RunFilter> change)
    {
        var copy = new RunFilter
        {
            Search = filter.Search, Tag = filter.Tag, Environment = filter.Environment, Branch = filter.Branch,
            Machine = filter.Machine, Status = filter.Status, Range = filter.Range, CustomRange = filter.CustomRange
        };
        change(copy);
        return copy;
    }

    var active = new List<(string Label, string Url)>();
    if (filter.Search != null) active.Add(($"Search: {filter.Search}", Query(With(f => f.Search = null))));
    if (filter.Tag != null) active.Add(($"Tag: {filter.Tag}", Query(With(f => f.Tag = null))));
    if (filter.Environment != null) active.Add(($"Environment: {filter.Environment}", Query(With(f => f.Environment = null))));
    if (filter.Branch != null) active.Add(($"Branch: {filter.Branch}", Query(With(f => f.Branch = null))));
    if (filter.Machine != null) active.Add(($"Machine: {filter.Machine}", Query(With(f => f.Machine = null))));
    if (filter.Status != null) active.Add(($"Status: {filter.Status}", Query(With(f => f.Status = null))));
    if (filter.CustomRange != null || filter.Range != RunFilter.AnyTime)
    {
        var rangeLabel = filter.CustomRange is { } custom ? $"{custom.Start.ToDay()} – {custom.End.ToDay()}" : RunFilter.RangeLabel(filter.Range);
        active.Add(($"Date: {rangeLabel}", Query(With(f => { f.Range = RunFilter.AnyTime; f.CustomRange = null; }))));
    }
}

<main class="wrap page" style="padding-top: 32px; gap: 18px">
    <div class="spread" style="justify-content: flex-start; gap: 8px 16px">
        <h1 class="page-title">Test runs</h1>
        <span class="muted">@($"{allRuns.Count} stored · newest first")</span>
    </div>

    @if (allRuns.Count == 0)
    {
        <section class="card empty">
            <span class="mark">@ReportUi.Icon("i-upload", "xl")</span>
            <h2>No test runs yet</h2>
            <p>Runs appear here as soon as a test run uploads its results to this server. Send them with <span class="mono">BDTestReportServer.SendDataAndGetReportUriAsync</span> to this endpoint:</p>
            <pre class="code" style="width: 100%; max-width: 520px; text-align: left">POST @(Context.Request.PathBase.Add("/bdtest/data").ToUriComponent())</pre>
            <a class="lnk" href="https://thomhurst.github.io/BDTest/docs/report-server/sending-results" target="_blank" rel="noopener">How to send results</a>
        </section>
    }
    else
    {
        <form role="search" class="card filters" method="get" action="@path" style="padding: 16px" data-autosubmit>
            <label class="field" style="flex: 2 1 260px">Search
                <span class="search">@ReportUi.Icon("i-search")<input class="inp" type="search" name="q" value="@filter.Search" placeholder="Tag, environment, branch or machine"></span>
            </label>
            @Select("Tag", "tag", allRuns.Select(run => run.Tag), filter.Tag)
            @Select("Environment", "environment", allRuns.Select(run => run.Environment), filter.Environment)
            @Select("Branch", "branch", allRuns.Select(run => run.BranchName), filter.Branch)
            @Select("Machine", "machine", allRuns.Select(run => run.MachineName), filter.Machine)
            @if (filter.Status != null)
            {
                <input type="hidden" name="status" value="@filter.Status">
            }
            @if (pageSize != 25)
            {
                <input type="hidden" name="perPage" value="@pageSize">
            }
            @if (filter.CustomRange != null)
            {
                <input type="hidden" name="range" value="@RunFilter.Custom">
                <input type="hidden" name="datetimerange" value="@filter.CustomRangeValue">
            }
            else if (filter.Range != RunFilter.AnyTime)
            {
                <input type="hidden" name="range" value="@filter.Range">
            }
            <div class="cluster" style="flex: 1 1 260px; min-height: 36px">
                <a class="chip @(filter.Status == null ? "on" : "")" href="@Query(With(f => f.Status = null))" aria-current="@(filter.Status == null ? "true" : null)">Any status</a>
                <a class="chip @(filter.Status == nameof(Status.Failed) ? "on" : "")" href="@Query(With(f => f.Status = nameof(Status.Failed)))" aria-current="@(filter.Status == nameof(Status.Failed) ? "true" : null)">@Status.Failed.StatusIcon()Failed</a>
                <a class="chip @(filter.Status == nameof(Status.Passed) ? "on" : "")" href="@Query(With(f => f.Status = nameof(Status.Passed)))" aria-current="@(filter.Status == nameof(Status.Passed) ? "true" : null)">@Status.Passed.StatusIcon()Passed</a>
            </div>
            <noscript><button class="btn sm" type="submit">Apply</button></noscript>
        </form>

        @if (active.Count > 0)
        {
            <div class="cluster">
                <span class="small muted">Filtered by</span>
                @foreach (var (label, url) in active)
                {
                    <a class="chip on" href="@url" aria-label="@($"Remove filter {label}")">@label@(ReportUi.Icon("i-x"))</a>
                }
                <a class="btn ghost sm link" href="@path">Clear filters</a>
            </div>
        }

        @if (runs.Length == 0)
        {
            <section class="card empty">
                <span class="mark">@ReportUi.Icon("i-search", "xl")</span>
                <h2>No runs match</h2>
                <p>None of the @allRuns.Count stored runs match these filters.</p>
                <div class="cluster"><a class="btn pri" href="@path">Clear filters</a></div>
            </section>
        }
        else
        {
            <section class="card clip" aria-label="Runs">
                <div class="table-scroll">
                    <table class="t wide">
                        <thead>
                        <tr>
                            <th scope="col">Run</th>
                            <th scope="col">Result</th>
                            <th scope="col">Scenarios</th>
                            <th scope="col">Environment</th>
                            <th scope="col">Branch</th>
                            <th scope="col">Machine</th>
                            <th scope="col" class="num">Duration</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var record in pager.ItemsForCurrentPage)
                        {
                            var reportUrl = Url.Content("~/bdtest/report/" + Uri.EscapeDataString(record.RecordId ?? string.Empty) + "/summary");
                            var counts = record.Counts ?? new Counts();
                            var total = Math.Max(counts.Total, 0);
                            var other = Math.Max(total - counts.Passed - counts.Failed, 0);
                            var duration = record.FinishedAtDateTime - record.StartedAtDateTime;
                            // Runs read as failed, inconclusive or passed; not implemented and skipped scenarios don't fail a run.
                            var resultStatus = record.RunResult();
                            var resultText = resultStatus switch
                            {
                                Status.Failed => $"{counts.Failed} failed",
                                _ when total == 0 => "No scenarios",
                                _ => resultStatus.Label()
                            };
                            var when = record.StartedAtDateTime.ToRunDate(record.StartedAtDateTime.Year != today.Year)
                                       + (record.StartedAtDateTime.Date == today ? " · today" : string.Empty);
                            <tr>
                                <td>
                                    <a href="@reportUrl" style="text-decoration: none; color: var(--ink); display: flex; flex-direction: column">
                                        <span class="strong">@(string.IsNullOrEmpty(record.Tag) ? "Test run" : record.Tag)</span>
                                        <span class="small muted">@(string.IsNullOrEmpty(when) ? "Unknown date" : when)</span>
                                    </a>
                                </td>
                                <td>
                                    @if (total == 0)
                                    {
                                        <span class="pill q">@resultText</span>
                                    }
                                    else
                                    {
                                        @resultStatus.Pill(resultText)
                                    }
                                </td>
                                <td>
                                    <div class="cluster" style="gap: 10px; flex-wrap: nowrap">
                                        <span class="mini" aria-hidden="true">
                                            @if (total > 0)
                                            {
                                                <span style="width: @ReportUi.Percent(counts.Passed, total)%; background: var(--pass)"></span>
                                                <span style="width: @ReportUi.Percent(other, total)%; background: var(--inc)"></span>
                                                <span style="width: @ReportUi.Percent(counts.Failed, total)%; background: var(--fail)"></span>
                                            }
                                        </span>
                                        <span class="mono muted">@($"{counts.Passed}/{total} passed")</span>
                                    </div>
                                </td>
                                <td>@record.Environment</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(record.BranchName))
                                    {
                                        <span class="tag">@record.BranchName</span>
                                    }
                                </td>
                                <td>@record.MachineName</td>
                                <td class="num">@(duration > TimeSpan.Zero ? duration.ToShortDuration() : "—")</td>
                                <td class="actions">
                                    <details class="menu">
                                        <summary class="btn ghost sm icon" aria-label="@(isAdmin ? "More actions for this run, including Delete" : "More actions for this run")">@ReportUi.Icon("i-more")</summary>
                                        <ul class="menu-list">
                                            <li><a class="menu-item" href="@reportUrl">View report</a></li>
                                            <li><button class="menu-item" type="button" data-bdtest-action="copy-url" data-url="@reportUrl">Copy link</button></li>
                                            @if (isAdmin)
                                            {
                                                <li class="menu-sep" role="separator"></li>
                                                <li>
                                                    <form method="post" action="@Url.Content("~/bdtest/report/delete/" + Uri.EscapeDataString(record.RecordId ?? ""))">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="menu-item danger"
                                                                data-bdtest-action="delete"
                                                                data-test-id="@record.RecordId"
                                                                data-tag="@record.Tag"
                                                                data-environment="@record.Environment"
                                                                data-branch="@record.BranchName"
                                                                data-date="@record.StartedAtDateTime">Delete</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @await Html.PartialAsync("_PaginationButtons", pagination)
            </section>
        }
    }
</main>

@functions
{
    private Microsoft.AspNetCore.Html.IHtmlContent Select(string label, string name, IEnumerable<string> values, string selected)
    {
        var encoder = System.Text.Encodings.Web.HtmlEncoder.Default;
        var options = values.Where(value => !string.IsNullOrEmpty(value)).Distinct(StringComparer.Ordinal)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase).ToList();
        if (selected != null && !options.Contains(selected, StringComparer.Ordinal))
        {
            options.Insert(0, selected);
        }

        var html = new System.Text.StringBuilder();
        html.Append($"<label class=\"field\" style=\"flex: 1 1 150px\">{encoder.Encode(label)}<select class=\"inp\" name=\"{name}\">");
        html.Append("<option value=\"\">Any</option>");
        foreach (var option in options)
        {
            var isSelected = string.Equals(option, selected, StringComparison.Ordinal) ? " selected" : string.Empty;
            html.Append($"<option value=\"{encoder.Encode(option)}\"{isSelected}>{encoder.Encode(option)}</option>");
        }

        html.Append("</select></label>");
        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }
}
