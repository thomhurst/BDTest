@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Razor.Reports.Storage
@using BDTest.Test
@model IEnumerable<Attachment>
@{
    // Only the stored report identity is authoritative; captured URIs and scenario ReportIds are not.
    var reportId = (ViewData[nameof(ReportLayoutViewModel)] as ReportLayoutViewModel)?.Report?.Id;
}
@foreach (var attempt in Model.Where(file => file != null).GroupBy(file => file.AttemptNumber).OrderBy(group => group.Key))
{
    <section class="attachment-list" aria-label="Attachments" data-attempt="@attempt.Key">
        <div class="k">Attachments · Attempt @attempt.Key</div>
        <ul>
            @foreach (var file in attempt)
            {
                var url = AttachmentStorage.IsValidId(reportId) && AttachmentStorage.IsValidId(file.Id)
                    ? Url.Action("Download", "Attachments", new { reportId, attachmentId = file.Id }) : null;
                var preview = url != null && IsRasterImage(file.MimeType);
                <li class="attachment-item" data-attachment-id="@file.Id">
                    @if (preview)
                    {
                        <button class="attachment-preview" type="button" data-bdtest-action="preview-attachment" aria-label="Preview @file.Name">
                            <img src="@url" alt="@file.Name" loading="lazy" data-attachment-image />
                        </button>
                        <span class="small muted" data-attachment-unavailable hidden>Preview unavailable. Try downloading the attachment.</span>
                    }
                    <div>
                        @if (url != null)
                        {
                            <a class="lnk" href="@url" download>@file.Name</a>
                        }
                        else
                        {
                            <span>@file.Name</span>
                            <span class="small muted">Content unavailable</span>
                        }
                        <div class="small muted">@file.MimeType · @file.Length bytes</div>
                    </div>
                </li>
            }
        </ul>
    </section>
}
@functions
{
    // Never infer safety from a file extension or from image/* (which also includes SVG).
    private static bool IsRasterImage(string? mimeType) => mimeType?.ToLowerInvariant() is
        "image/png" or "image/jpeg" or "image/gif" or "image/webp" or "image/bmp" or "image/avif";
}
