<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DefineConstants>$(DefineConstants);BDTEST_NUNIT</DefineConstants>
        
        <IsPackable>false</IsPackable>
        
        <SignAssembly>True</SignAssembly>
        
        <AssemblyOriginatorKeyFile>..\StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CompareNETObjects" Version="4.84.0" />
        <PackageReference Include="nunit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <!-- The Identity token cache's Xml dependency is not pruned in test projects. -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BDTest.Example\BDTest.Example.csproj" />
      <ProjectReference Include="..\BDTest.NUnit\BDTest.NUnit.csproj" />
      <ProjectReference Include="..\BDTest.Razor.Reports\BDTest.Razor.Reports.csproj" />
      <ProjectReference Include="..\BDTest.ReportGenerator.RazorServer\BDTest.ReportGenerator.RazorServer.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\TestUtilities\ExceptionRegistrationProbe.cs" Link="Helpers\ExceptionRegistrationProbe.cs" />
        <Compile Include="..\TestUtilities\LifecycleContract.cs" Link="Helpers\LifecycleContract.cs" />
        <Compile Include="..\TestUtilities\HistoricalReportFixture.cs" Link="Helpers\HistoricalReportFixture.cs" />
        <None Update="Data\JsonData-v2.0.60.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\ReportJson.cs" Link="Helpers\ReportJson.cs" />
    <Using Include="BDTest.TestUtilities" />
    <ProjectReference Include="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\AdapterConformanceTests.cs" Link="Conformance\AdapterConformanceTests.cs" />
    <Compile Include="..\TestUtilities\MethodIdentityContract.cs" Link="Helpers\MethodIdentityContract.cs" />
  </ItemGroup>
</Project>
