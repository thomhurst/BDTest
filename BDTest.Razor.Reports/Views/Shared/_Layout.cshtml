@addTagHelper "*, Microsoft.AspNetCore.Mvc.TagHelpers"
@using BDTest.Razor.Reports.Models.ViewModels
@{
    var layoutModel = ViewData[nameof(ReportLayoutViewModel)] as ReportLayoutViewModel ?? new ReportLayoutViewModel();
    var title = ViewBag.Title as string;
    title = string.IsNullOrEmpty(title) ? "BDTest" : title + " · BDTest";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>@title</title>
    <link rel="icon" href="@Url.ReportAsset("/favicon.ico")">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="@Url.ReportAsset("/css/bdtest-report.css")"/>
    <script src="@Url.ReportAsset("/js/BDTest.js")" defer></script>
</head>
<body>
@await Html.PartialAsync("_SvgIcons")
@await Html.PartialAsync("_NavBarHeader", layoutModel)
@RenderBody()
<div id="snackbar" role="status" aria-live="polite"></div>
</body>
</html>
