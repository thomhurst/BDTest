<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <TargetFramework>net10.0</TargetFramework>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

        <PackageId>BDTest.Razor.Reports</PackageId>
        <Title>BDTest - ASP.NET Core Reports</Title>
        <Description>ASP.NET Core MVC controllers, Razor views and static assets for hosting BDTest reports.</Description>
        <PackageTags>test tdd bdd testing given when then reporting razor aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="wwwroot\**\*" />
      <EmbeddedResource Include="wwwroot\**\*" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\BDTest.Contracts\BDTest.Contracts.csproj" />
    </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BDTest.Tests" Key="$(BDTestPublicKey)" />
  </ItemGroup>
</Project>
