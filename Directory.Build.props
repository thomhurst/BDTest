<Project>
 <PropertyGroup>
  <LangVersion>latest</LangVersion>
  <ImplicitUsings>enable</ImplicitUsings>
  <IsPackable>false</IsPackable>
  <!-- Read project opt-ins before SDK defaults initialize XML documentation and assembly metadata. -->
  <BeforeMicrosoftNETSdkTargets>$(MSBuildThisFileDirectory)build/PackageMetadata.targets</BeforeMicrosoftNETSdkTargets>
  <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
 </PropertyGroup>
 <!-- Runtime packages retain their existing strong-name identity. Compiler extensions
      stay unsigned; only the test assembly with friend access needs signing. -->
 <PropertyGroup>
  <BDTestPublicKey></BDTestPublicKey>
  <SignAssembly>false</SignAssembly>
  <SignAssembly Condition="'$(MSBuildProjectName)' == 'BDTest' Or '$(MSBuildProjectName)' == 'BDTest.NUnit' Or '$(MSBuildProjectName)' == 'BDTest.xUnit' Or '$(MSBuildProjectName)' == 'BDTest.MSTest' Or '$(MSBuildProjectName)' == 'BDTest.TUnit' Or '$(MSBuildProjectName)' == 'BDTest.Razor.Reports' Or '$(MSBuildProjectName)' == 'BDTest.Tests'">true</SignAssembly>
  <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true'">$(MSBuildThisFileDirectory)StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
 </PropertyGroup>
 <!-- Strict diagnostics for core, adapters, non-shipping code and Roslyn packages. See BUILDING.md. -->
 <!-- The report suite is tracked by #921. -->
 <PropertyGroup Condition="'$(MSBuildProjectName)' != 'BDTest.ReportGenerator.Tests'
                          And ($([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '(?i)Tests|Pipeline|Example|ReportGenerator'))
                               Or '$(MSBuildProjectName)' == 'BDTest.SourceGenerator'
                               Or '$(MSBuildProjectName)' == 'BDTest.Analyzers'
                               Or '$(MSBuildProjectName)' == 'BDTest'
                               Or '$(MSBuildProjectName)' == 'BDTest.NUnit'
                               Or '$(MSBuildProjectName)' == 'BDTest.xUnit'
                               Or '$(MSBuildProjectName)' == 'BDTest.MSTest'
                               Or '$(MSBuildProjectName)' == 'BDTest.TUnit')">
  <Nullable>enable</Nullable>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
 </PropertyGroup>
</Project>
