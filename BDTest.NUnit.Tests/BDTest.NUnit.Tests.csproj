<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);BDTEST_NUNIT</DefineConstants>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="nunit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDTest.NUnit\BDTest.NUnit.csproj" />
    <ProjectReference Include="..\BDTest.Example\BDTest.Example.csproj" />
    <ProjectReference Include="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\BDTest.Analyzers\BDTest.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\MyTestContext.cs" Link="MyTestContext.cs" />
    <Compile Include="..\TestUtilities\NUnitTestValue.cs" Link="Helpers\TestValue.cs" />
    <Compile Include="..\TestUtilities\NUnitFileHelpers.cs" Link="Helpers\FileHelpers.cs" />
    <Compile Include="..\TestUtilities\OutputCaptureInspection.cs" Link="Helpers\OutputCaptureInspection.cs" />
    <Compile Include="..\TestUtilities\LifecycleContract.cs" Link="Helpers\LifecycleContract.cs" />
    <Compile Include="..\TestUtilities\MethodIdentityContract.cs" Link="Helpers\MethodIdentityContract.cs" />
    <Compile Include="..\TestUtilities\AssemblyRunContract.cs" Link="Conformance\AssemblyRunContract.cs" />
    <Compile Include="..\TestUtilities\AdapterConformanceTests.cs" Link="Conformance\AdapterConformanceTests.cs" />
    <Using Include="BDTest.TestUtilities" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <ProjectReference Include="..\BDTest.Reporting\BDTest.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\ReportContextContractTests.cs" Link="Conformance\ReportContextContractTests.cs" />
  </ItemGroup>
</Project>
