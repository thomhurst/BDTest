@using BDTest.Razor.Reports.Helpers
@model BDTest.Test.Scenario

@if (Model.RetryCount > 0 && Model.Attempts?.Count > 0)
{
    <section class="retry-history" aria-label="Retry history">
        <div class="card-head">
            <h2>Attempts</h2>
            <span class="small muted">Retries: @Model.RetryCount</span>
        </div>
        <div class="table-scroll">
            <table class="t top">
                <thead><tr><th scope="col">Attempt</th><th scope="col">Result</th><th scope="col" class="num">Took</th><th scope="col">Exception</th></tr></thead>
                <tbody>
                @foreach (var attempt in Model.Attempts)
                {
                    <tr>
                        <td>@attempt.Number</td>
                        <td>@attempt.Status.Pill()</td>
                        <td class="num" title="@attempt.TimeTaken">@attempt.TimeTaken.ToShortDuration()</td>
                        <td style="min-width: 0">
                            @if (attempt.Exception != null)
                            {
                                <details class="expander">
                                    <summary class="mono" style="overflow-wrap: anywhere">@attempt.Exception.TypeName: @attempt.Exception.Message</summary>
                                    <pre class="code" style="margin-top: 8px">@attempt.Exception.AsString</pre>
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
