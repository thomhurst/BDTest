<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The executable entry point hosts isolated file-store test workers. -->
        <OutputType>Exe</OutputType>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
        <GenerateTestingPlatformApplicationHelper>true</GenerateTestingPlatformApplicationHelper>
        
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CompareNETObjects" Version="4.84.0" />
        <PackageReference Include="TUnit" Version="1.75.0" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <!-- The Identity token cache's Xml dependency is not pruned in test projects. -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BDTest.TUnit\BDTest.TUnit.csproj" />
      <ProjectReference Include="..\BDTest.Razor.Reports\BDTest.Razor.Reports.csproj" />
      <ProjectReference Include="..\BDTest.ReportGenerator.RazorServer\BDTest.ReportGenerator.RazorServer.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\TestUtilities\MyTestContext.cs" Link="MyTestContext.cs" />
        <Compile Include="..\TestUtilities\HistoricalReportFixture.cs" Link="Helpers\HistoricalReportFixture.cs" />
        <None Update="Data\JsonData-v2.0.60.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestUtilities\ReportJson.cs" Link="Helpers\ReportJson.cs" />
    <Using Include="BDTest.TestUtilities" />
    <ProjectReference Include="..\BDTest.SourceGenerator\BDTest.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDTest.Analyzers\BDTest.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\BDTest.Reports.Storage.FileSystem\BDTest.Reports.Storage.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDTest.Reporting\BDTest.Reporting.csproj" />
  </ItemGroup>
</Project>
