@using BDTest.Contracts
@using BDTest.Rendering
@using BDTest.Razor.Reports.Constants
@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models.ViewModels
@model ReportLayoutViewModel
@{
    var report = Model.Report ?? throw new InvalidOperationException("Report metadata is required for this view.");
    // Copy only compact scalar display data. Rendering never reloads or retains a report graph.
    var overview = new ReportRunOverview(Model.ScenarioCount, Model.NotRunCount, Model.Counts,
        report.Environment, report.Tag, report.BranchName, report.MachineName, report.Version,
        Model.Timer, report.CustomProperties);
    var scenariosUrl = Url.ReportAction("AllScenarios", new { id = report.Id ?? string.Empty });
    string? StatusUrl(Status? status) => status.HasValue
        ? scenariosUrl + "?" + StatusConstants.FilterByStatusQueryParameterName + "=" + status.Value
        : scenariosUrl;
}
<div class="rpt bdtest-fragment">
    @Html.Raw(ReportHtmlRenderer.RenderRunOverview(overview, StatusUrl,
        Url.ReportAction("Warnings", new { id = report.Id ?? string.Empty })))
</div>
