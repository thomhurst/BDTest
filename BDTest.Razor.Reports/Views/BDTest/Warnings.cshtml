@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models.ViewModels
@model BDTest.Maps.BDTestOutputModel
@{
    var run = (ReportLayoutViewModel)ViewData[nameof(ReportLayoutViewModel)];
    ViewBag.Title = run.Title + " not run";
    ViewData["RunTab"] = "notrun";
    Layout = "_Layout";

    var reportUrl = Url.Content("~/bdtest/report/" + Uri.EscapeDataString(Model.Id ?? string.Empty));
    var notRun = (Model.NotRun ?? new List<BDTest.Test.BuildableTest>()).Where(test => test != null)
        .OrderBy(test => test.GetStoryText()).ThenBy(test => test.GetScenarioText()).ToList();

    string FileName(string path) => string.IsNullOrEmpty(path) ? string.Empty : path.Replace('\\', '/')[(path.Replace('\\', '/').LastIndexOf('/') + 1)..];
}

@await Html.PartialAsync("_RunHeader", run)

<main class="wrap page">
    @if (notRun.Count == 0)
    {
        <section class="card empty">
            <span class="mark p">@ReportUi.Icon("i-pass", "xl")</span>
            <h2>Every declared test ran</h2>
            <p>No test finished without calling <span class="mono">.BDTestAsync()</span>, so nothing is missing from this run.</p>
            <a class="lnk" href="@reportUrl/summary">Back to the overview</a>
        </section>
    }
    else
    {
        <div class="split" style="gap: 20px">
            <div class="stack" style="flex: 999 1 560px; min-width: 0; gap: 8px">
                <h2 class="h2">@($"{notRun.Count} test{(notRun.Count == 1 ? " was" : "s were")} declared but never ran")</h2>
                <p class="muted" style="max-width: 68ch">
                    These test methods exist, but they finished without calling <span class="mono">.BDTestAsync()</span>, so BDTest recorded no steps for them.
                    @($"They aren’t counted in the {run.Scenarios.Count} scenario{(run.Scenarios.Count == 1 ? "" : "s")}.")
                </p>
            </div>
            <div class="card card-pad" style="flex: 1 1 340px; min-width: 0; gap: 8px; padding: 16px 18px">
                <span class="strong" style="font-size: 14px">Usual fix</span>
                <p class="small muted">Make sure each test’s step chain ends with <span class="mono">.BDTestAsync()</span> and is awaited.</p>
                <pre class="code">await Given(() =&gt; ...)
    .When(() =&gt; ...)
    .Then(() =&gt; ...)
    .BDTestAsync();</pre>
                <a class="lnk" href="https://thomhurst.github.io/BDTest/docs/writing-tests/scenarios" target="_blank" rel="noopener">Docs: writing a scenario</a>
            </div>
        </div>

        <section class="card clip" aria-label="Tests that never ran">
            <div class="table-scroll">
                <table class="t">
                    <thead>
                    <tr>
                        <th scope="col" style="width: 32px"><span class="visually-hidden">Status</span></th>
                        <th scope="col">Scenario</th>
                        <th scope="col">Story</th>
                        <th scope="col">File</th>
                        <th scope="col">Test method</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var test in notRun)
                    {
                        <tr>
                            <td>@ReportUi.Icon("i-notrun", "ico-r")</td>
                            <td class="strong">@test.GetScenarioText()</td>
                            <td>@ReportUi.StoryTitle(test.GetStoryText())</td>
                            <td class="mono" title="@test.CallerFile">@FileName(test.CallerFile)</td>
                            <td class="mono">@test.CallerMember</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
