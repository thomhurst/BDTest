  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDTest.Contracts\BDTest.Contracts.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
