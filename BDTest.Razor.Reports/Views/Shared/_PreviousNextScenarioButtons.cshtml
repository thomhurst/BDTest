@using BDTest.Razor.Reports.Extensions
@using BDTest.Razor.Reports.Helpers
@model BDTest.Maps.BDTestOutputModel

@{
    var thisReport = Model;
    var currentScenarioId = Context.Request.Path.Value.Split("/scenario/")[1].TrimEnd('/');
    var thisScenarioIndex = thisReport.Scenarios.FindIndex(scenario => scenario.Guid == currentScenarioId);
    var lastScenario = thisReport.Scenarios.ElementAtOrDefault(thisScenarioIndex - 1);
    var nextScenario = thisReport.Scenarios.ElementAtOrDefault(thisScenarioIndex + 1);
}

@if (lastScenario != null)
{
    <a href="@GenerateUrl(lastScenario.Guid)">
        <button type="button" class="btn btn-primary px-4 gap-3" data-bdtest-action="spin">Previous Scenario</button>
    </a>
}
@if (nextScenario != null)
{
    <a href="@GenerateUrl(nextScenario.Guid)">
        <button type="button" class="btn btn-primary px-4 gap-3" data-bdtest-action="spin">Next Scenario</button>
    </a>
}

@functions
{
    private string GenerateUrl(string id)
    {
        return Context.GetLocalUrl($"/bdtest/report/{Uri.EscapeDataString(Model.Id)}/scenario/{Uri.EscapeDataString(id)}");
    }
}
