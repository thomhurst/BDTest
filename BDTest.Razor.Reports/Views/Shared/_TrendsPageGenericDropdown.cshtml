@model BDTest.Razor.Reports.Views.BDTest.TrendsPageGenericDropdownViewModel

<li class="nav-item dropdown">
    <a id="@Model.ButtonId" class="bg-primary text-white nav-link dropdown-toggle" aria-haspopup="true" aria-controls="dropdown-menu" data-bs-toggle="dropdown" href="#" aria-expanded="false">
        @Model.ButtonText
    </a>
    <ul class="dropdown-menu">
        @foreach (var value in Model.DropdownValues)
        {
            <li><a class="dropdown-item" href="#" data-value="@value" data-bdtest-action="filter" data-parameter="@Model.QueryParameterName">@value</a></li>
        }
    </ul>
</li>