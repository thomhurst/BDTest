@using BDTest.Razor.Reports.Helpers
@model BDTest.Razor.Reports.Models.ViewModels.ErrorViewModel
@{
    ViewBag.Title = "Error";
    Layout = "_Layout";
    // After UseExceptionHandler re-executes, the request path is the error route, so retry the original path.
    var failedPath = Context.Features.Get<Microsoft.AspNetCore.Diagnostics.IExceptionHandlerPathFeature>()?.Path;
    var retryUrl = failedPath == null ? Context.GetLocalUrl() : Context.GetLocalUrl(failedPath);
}

<main class="wrap page">
    <section class="card empty">
        <span class="mark f">@ReportUi.Icon("i-warn", "xl")</span>
        <h1 class="h2" style="font-size: 18px">Something went wrong on the server</h1>
        <p>This page couldn’t load. Try again, or send the reference below to whoever runs this server.</p>
        @if (Model?.ShowRequestId == true)
        {
            <span class="mono muted">Reference @Model.RequestId</span>
        }
        <div class="cluster">
            <a class="btn pri" href="@retryUrl">Try again</a>
            <a class="btn" href="~/bdtest/report/test-runs">All runs</a>
        </div>
    </section>
</main>
