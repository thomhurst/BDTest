@using System.Text.RegularExpressions
@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models
@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Contracts
@model ScenarioResult

@{
    ViewBag.Title = Model.ScenarioText;
    Layout = "_Layout";

    var run = ViewData[nameof(ReportLayoutViewModel)] as ReportLayoutViewModel;
    var report = run?.Report;
    var reportId = report?.Id ?? Model.ReportId ?? string.Empty;
    var storyText = Model.StoryText;
    var storyUrl = Url.ReportAction("AllScenarios", new { id = reportId }) + "?story=" + Uri.EscapeDataString(storyText ?? string.Empty);

    var siblings = (ViewData[nameof(BDTest.Contracts.BDTestReport)] as BDTest.Contracts.BDTestReport)?.Scenarios?.Where(s => s != null).ToList() ?? new List<ScenarioResult>();
    var index = siblings.FindIndex(scenario => scenario.Guid == Model.Guid);
    var previous = index > 0 ? siblings[index - 1] : null;
    var next = index >= 0 && index < siblings.Count - 1 ? siblings[index + 1] : null;

    var attempts = Model.Attempts.Count;
    var file = string.IsNullOrEmpty(Model.FileName) ? null : Model.FileName.Replace('\\', '/');
    var fileName = file?.Split('/')[^1];

    string? ScenarioUrl(ScenarioResult scenario) => Url.ReportScenario(reportId, scenario.Guid);
}

<section class="page-head padded" aria-label="Scenario">
    <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a class="lnk" href="@Url.ReportAction("TestRuns")">Runs</a><span aria-hidden="true">/</span>
            @if (run != null)
            {
                var started = run.Timer.TestsStartedAt;
                <a class="lnk" href="@(Url.ReportAction("Summary", new { id = reportId }))">@run.Title@(started == default ? "" : " · " + started.ToRunDate(includeYear: false))</a><span aria-hidden="true">/</span>
                <a class="lnk" href="@storyUrl">@ReportUi.StoryTitle(storyText)</a>
                var total = run.ScenarioCount;
                var failed = run.Counts[Status.Failed];
                <span aria-hidden="true">/</span>
                @run.Status.Pill(run.Status == Status.Failed ? $"Run failed · {failed} of {total}" : "Run " + run.Status.Label().ToLowerInvariant())
            }
            else
            {
                <span>@ReportUi.StoryTitle(storyText)</span>
            }
        </nav>
        <div class="title-row" style="align-items: flex-start; gap: 12px 20px">
            <div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
                <h1 style="font-size: 30px">@Model.ScenarioText</h1>
                <div class="cluster">
                    @Model.Status.Pill()
                    @if (Model.TimedOut)
                    {
                        <span class="pill q">Timed out</span>
                    }
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            </div>
            <div class="cluster">
                @if (index >= 0)
                {
                    <span class="small muted">@(index + 1) of @siblings.Count in this run</span>
                }
                @if (previous != null && !string.IsNullOrEmpty(previous.Guid))
                {
                    <a class="btn sm" href="@ScenarioUrl(previous)" rel="prev">@ReportUi.Icon("i-chev-l")Previous</a>
                }
                else
                {
                    <span class="btn sm" aria-disabled="true">@ReportUi.Icon("i-chev-l")Previous</span>
                }
                @if (next != null && !string.IsNullOrEmpty(next.Guid))
                {
                    <a class="btn sm" href="@ScenarioUrl(next)" rel="next">Next@(ReportUi.Icon("i-chev-r"))</a>
                }
                else
                {
                    <span class="btn sm" aria-disabled="true">Next@(ReportUi.Icon("i-chev-r"))</span>
                }
                @await Html.PartialAsync("_CopyLinkButton")
            </div>
        </div>
        <div class="meta">
            <span>Story <b>@ReportUi.StoryTitle(storyText)</b></span>
            <span>Duration <b>@Model.TimeTaken.ToShortDuration()@(attempts > 1 ? $" over {attempts} attempts" : "")</b></span>
            @if (Model.StartTime != default)
            {
                <span>Started <b>@Model.StartTime.ToClock()</b></span>
            }
            @if (fileName != null)
            {
                <span>Test <b class="mono">@fileName</b></span>
            }
        </div>
    </div>
</section>

<main class="wrap page tight" style="padding-top: 24px">
    <div class="split">
        <div class="main-col rpt bdtest-fragment">
            @Html.Raw(BDTest.Rendering.ReportHtmlRenderer.RenderScenario(Model, HostedRendering.Options(Url, run)))
        </div>

        <aside class="side-col">
            @{
                var storyLines = ReportUi.StoryLines(storyText);
            }
            <section class="card card-pad" aria-labelledby="story" style="gap: 10px">
                <h2 id="story">Story</h2>
                @if (storyLines.Count == 0)
                {
                    <p class="small muted">This scenario has no story.</p>
                }
                else
                {
                    <p style="font-size: 14.5px">
                        @foreach (var line in storyLines)
                        {
                            var match = Regex.Match(line, "^(As an?|I want|So that)\\b(.*)$", RegexOptions.IgnoreCase);
                            if (match.Success)
                            {
                                <b style="font-weight: 600">@match.Groups[1].Value</b>@match.Groups[2].Value<br>
                            }
                            else
                            {
                                @line<br>
                            }
                        }
                    </p>
                }
                @if (run != null)
                {
                    var inStory = siblings.Count(scenario => scenario.StoryText == storyText);
                    <a class="lnk" href="@storyUrl">@inStory @(inStory == 1 ? "scenario" : "scenarios") in this story</a>
                }
            </section>

            <section class="card card-pad" aria-labelledby="details" style="gap: 10px">
                <h2 id="details">Details</h2>
                <dl class="dl">
                    @if (file != null)
                    {
                        <dt>File</dt><dd class="mono">@file</dd>
                    }
                    <dt>Retries</dt><dd>@(Model.RetryCount == 0 ? "None" : $"{Model.RetryCount} ({Model.RetryCount + 1} attempts)")</dd>
                    @if (Model.Timeout != null)
                    {
                        <dt>Timeout</dt><dd>@Model.Timeout.Value.ToShortDuration()</dd>
                    }
                    @if (Model.StartTime != default)
                    {
                        <dt>Started</dt><dd>@Model.StartTime.ToClock(milliseconds: true)</dd>
                    }
                    @if (Model.EndTime != default)
                    {
                        <dt>Ended</dt><dd>@Model.EndTime.ToClock(milliseconds: true)</dd>
                    }
                </dl>
                @if (report != null)
                {
                    <div class="k" style="margin-top: 4px">Run</div>
                    <dl class="dl">
                        @if (!string.IsNullOrEmpty(report.Tag))
                        {
                            <dt>Tag</dt><dd>@report.Tag</dd>
                        }
                        @if (!string.IsNullOrEmpty(report.Environment))
                        {
                            <dt>Environment</dt><dd>@report.Environment</dd>
                        }
                        @if (!string.IsNullOrEmpty(report.BranchName))
                        {
                            <dt>Branch</dt><dd>@report.BranchName</dd>
                        }
                    </dl>
                    <div class="cluster"><a class="lnk" href="@(Url.ReportAction("Summary", new { id = reportId }))">Run overview</a><a class="lnk" href="@(Url.ReportAction("RawJsonData", new { id = reportId }))" download>Run JSON</a></div>
                }
            </section>
        </aside>
    </div>
</main>
