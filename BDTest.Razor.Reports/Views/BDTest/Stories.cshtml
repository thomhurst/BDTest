@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Test
@model IGrouping<string, Scenario>[]
@{
    // The older Stories page is the Scenarios page grouped by story.
    var run = ViewData[nameof(ReportLayoutViewModel)] as ReportLayoutViewModel
        ?? throw new InvalidOperationException("The report layout model is required for this view.");
    ViewBag.Title = run.Title + " stories";
    ViewData["RunTab"] = "scenarios";
    Layout = "_Layout";
    var list = ScenarioListBuilder.Build(Model, run.Scenarios, run.Report?.Id, Context.Request, groupFixed: true);
}

@await Html.PartialAsync("_RunHeader", run)

<main class="wrap page tight">
    @await Html.PartialAsync("_ScenarioList", list)
</main>
