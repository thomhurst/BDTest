@model BDTest.Razor.Reports.Models.ViewModels.ReportLayoutViewModel
@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models
@using BDTest.Razor.Reports.Interfaces
@inject IEnumerable<IBDTestCustomHeaderLinksProvider> HeaderLinksProviders
@inject IEnumerable<IBDTestCustomSidebarLinksProvider> SidebarLinksProviders
@inject IEnumerable<IUserPersonalizer> Personalizers

@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    var isHistory = path.Contains("/report/history") || path.Contains("/report/trends")
                    || path.Contains("/report/test-run-flakiness") || path.Contains("/report/test-run-times");
    var isRuns = !isHistory;

    var headerLinks = HeaderLinksProviders.LastOrDefault()?.GetCustomLinks()?.ToList() ?? new List<CustomLinkData>();
    var reportLinks = SidebarLinksProviders.LastOrDefault()?.GetCustomLinks(ViewData[nameof(BDTest.Maps.BDTestOutputModel)] as BDTest.Maps.BDTestOutputModel)?.ToList() ?? new List<CustomLinkData>();

    var personalizer = Personalizers.LastOrDefault();
    var pictureUri = personalizer?.GetProfilePictureUri(Context);
    var userName = personalizer?.GetNameOfUser(Context);
    var userLinks = personalizer?.GetLinksForUser(Context) ?? new List<CustomLinkData>();
}

<header class="app-header">
    <div class="wrap">
        <a class="brand" href="@Url.ReportAction("TestRuns")"><span class="brand-mark" aria-hidden="true">BD</span>BDTest</a>
        <nav class="main-nav" aria-label="Main">
            <a class="navl @(isRuns ? "on" : "")" href="@Url.ReportAction("TestRuns")" aria-current="@(isRuns ? "page" : null)">Runs</a>
            <a class="navl @(isHistory ? "on" : "")" href="@Url.ReportAction("Trends")" aria-current="@(isHistory ? "page" : null)">History</a>
        </nav>
        <div class="grow"></div>

        <details class="menu">
            <summary class="btn ghost sm" aria-label="Links">
                <span class="hide-phone">Links</span><span class="show-phone">@ReportUi.Icon("i-menu", "lg")</span><span class="hide-phone">@ReportUi.Icon("i-chev-d")</span>
            </summary>
            <ul class="menu-list">
                @if (reportLinks.Count > 0)
                {
                    <li class="menu-head">@(Model?.Report == null ? "Links" : "This run")</li>
                    @foreach (var link in reportLinks)
                    {
                        <li>@LinkItem(link)</li>
                    }
                    <li class="menu-sep" role="separator"></li>
                }
                @if (headerLinks.Count > 0)
                {
                    <li class="menu-head">Team links</li>
                    @foreach (var link in headerLinks)
                    {
                        <li>@LinkItem(link)</li>
                    }
                    <li class="menu-sep" role="separator"></li>
                }
                <li class="menu-head">BDTest</li>
                <li><a class="menu-item" href="https://thomhurst.github.io/BDTest/" target="_blank" rel="noopener">Documentation</a></li>
                <li><a class="menu-item" href="https://github.com/thomhurst/BDTest" target="_blank" rel="noopener">GitHub</a></li>
                <li><a class="menu-item" href="https://github.com/thomhurst/BDTest/issues" target="_blank" rel="noopener">Report an issue</a></li>
            </ul>
        </details>

        @if (pictureUri != null || userName != null)
        {
            <details class="menu">
                <summary class="avatar" aria-label="@(userName == null ? "Account menu" : "Account menu for " + userName)">
                    @if (pictureUri != null)
                    {
                        <img src="@pictureUri" alt="">
                    }
                    else
                    {
                        @ReportUi.Initials(userName)
                    }
                </summary>
                <ul class="menu-list">
                    @if (userName != null)
                    {
                        <li class="menu-head">@userName</li>
                    }
                    @foreach (var link in userLinks)
                    {
                        <li>@LinkItem(link)</li>
                    }
                </ul>
            </details>
        }
    </div>
</header>

@functions
{
    private Microsoft.AspNetCore.Html.IHtmlContent LinkItem(CustomLinkData link)
    {
        var encoder = System.Text.Encodings.Web.HtmlEncoder.Default;
        return link.Url == null
            ? new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"menu-item\">{encoder.Encode(link.Text ?? string.Empty)}</span>")
            : new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"menu-item\" href=\"{encoder.Encode(link.Url)}\" target=\"_blank\">{encoder.Encode(link.Text ?? string.Empty)}</a>");
    }
}
