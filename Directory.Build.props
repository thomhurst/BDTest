<Project>
 <PropertyGroup>
  <LangVersion>latest</LangVersion>
  <ImplicitUsings>enable</ImplicitUsings>
  <IsPackable>false</IsPackable>
  <!-- Read project opt-ins before SDK defaults initialize XML documentation and assembly metadata. -->
  <BeforeMicrosoftNETSdkTargets>$(MSBuildThisFileDirectory)build/PackageMetadata.targets</BeforeMicrosoftNETSdkTargets>
  <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
 </PropertyGroup>
 <!-- Runtime packages retain their existing strong-name identity. Compiler extensions
      stay unsigned; only the test assembly with friend access needs signing. -->
 <PropertyGroup>
  <BDTestPublicKey></BDTestPublicKey>
  <SignAssembly>false</SignAssembly>
  <SignAssembly Condition="'$(MSBuildProjectName)' == 'BDTest' Or '$(MSBuildProjectName)' == 'BDTest.Contracts' Or '$(MSBuildProjectName)' == 'BDTest.NUnit' Or '$(MSBuildProjectName)' == 'BDTest.xUnit' Or '$(MSBuildProjectName)' == 'BDTest.MSTest' Or '$(MSBuildProjectName)' == 'BDTest.TUnit' Or '$(MSBuildProjectName)' == 'BDTest.Razor.Reports' Or '$(MSBuildProjectName)' == 'BDTest.Reports.Storage.FileSystem' Or '$(MSBuildProjectName)' == 'BDTest.Reports.Storage.AzureBlob' Or '$(MSBuildProjectName)' == 'BDTest.Tests'">true</SignAssembly>
  <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true'">$(MSBuildThisFileDirectory)StrongNameKeyPair.snk</AssemblyOriginatorKeyFile>
 </PropertyGroup>
 <PropertyGroup>
  <Nullable>enable</Nullable>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
 </PropertyGroup>
</Project>
