    <IsPackable>true</IsPackable>
    <PackageId>BDTest.Rendering</PackageId>
    <Title>BDTest - HTML Rendering</Title>
    <Description>Self-contained HTML reports and shared report fragments over immutable BDTest contracts, independent of test execution.</Description>
    <PackageTags>bdd testing reports html rendering contracts</PackageTags>
