@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Interfaces
@using BDTest.Razor.Reports.Models
@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Test
@model TimingsViewModel
@inject IDataRepository DataRepository
@{
    var run = Model.Layout;
    var report = run.Report ?? throw new InvalidOperationException("Report metadata is required for this view.");
    ViewBag.Title = run.Title + " timings";
    ViewData["RunTab"] = "timings";
    Layout = "_Layout";

    var reportId = report.Id ?? string.Empty;
    var slowest = Model.Slowest;
    var fastest = Model.Fastest;
    var scale = slowest.FirstOrDefault()?.TimeTaken.Ticks ?? 0;
    var slowestFiveShare = Model.SlowestFiveShare;

    // The median wall clock of recent runs with the same tag, ending with this run.
    var series = (await DataRepository.GetAllTestRunRecords(Context.RequestAborted) ?? Enumerable.Empty<TestRunSummary>())
        .Where(record => record != null && string.Equals(record.Tag, report.Tag, StringComparison.Ordinal))
        .OrderBy(record => record.StartedAtDateTime)
        .ToList();
    var position = series.FindIndex(record => record.RecordId == report.Id);
    var recent = (position < 0 ? series : series.Take(position + 1)).TakeLast(20)
        .Select(record => record.FinishedAtDateTime - record.StartedAtDateTime)
        .Where(duration => duration > TimeSpan.Zero)
        .OrderBy(duration => duration)
        .ToList();

    var historyUrl = Url.ReportAction("TimingVariance") + (string.IsNullOrEmpty(report.Tag) ? string.Empty : "?tag=" + Uri.EscapeDataString(report.Tag));
}

@await Html.PartialAsync("_RunHeader", run)

<main class="wrap page">
    @if (Model.TimedScenarioCount == 0)
    {
        <section class="card empty">
            <span class="mark">@ReportUi.Icon("i-clock", "xl")</span>
            <h2>No timings to show</h2>
            <p>This run recorded no scenarios, so there is nothing to time.</p>
        </section>
    }
    else
    {
        <section class="card stats" aria-label="Run timing summary">
            <div class="stat">
                <span class="k">Wall clock</span>
                <b>@(run.Timer.ElapsedTime > TimeSpan.Zero ? run.Timer.ElapsedTime.ToShortDuration() : "—")</b>
                @if (recent.Count >= 2)
                {
                    <span class="small muted">@($"median of last {recent.Count}: {recent[recent.Count / 2].ToShortDuration()}")</span>
                }
            </div>
            <div class="stat"><span class="k">Median scenario</span><b>@Model.Median.ToShortDuration()</b></div>
            <div class="stat"><span class="k">95th percentile</span><b>@Model.Percentile95.ToShortDuration()</b></div>
            <div class="stat">
                <span class="k">Slowest 5 share</span>
                <b>@($"{slowestFiveShare:0}%")</b>
                <span class="small muted">of total scenario time</span>
            </div>
        </section>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr)); gap: 20px; align-items: start">
            <section class="card clip" aria-labelledby="slowest">
                <div class="card-head"><h2 id="slowest">@($"Slowest {slowest.Count}")</h2><a class="lnk" href="@(Url.ReportAction("AllScenarios", new { id = reportId }))?order=durationDescending">Sort Scenarios by duration</a></div>
                @foreach (var scenario in slowest)
                {
                    @BarRow(scenario, reportId, scale)
                }
            </section>

            <section class="card clip" aria-labelledby="fastest">
                <div class="card-head"><h2 id="fastest">@($"Fastest {fastest.Count}")</h2><span class="small muted">same scale as slowest</span></div>
                @foreach (var scenario in fastest)
                {
                    @BarRow(scenario, reportId, scale)
                }
            </section>
        </div>

        <p class="notice">Step timings for one scenario are on its detail page. Changes over time are in <a class="lnk" href="@historyUrl">History › Timing variance</a>.</p>
    }
</main>

@functions
{
    private Microsoft.AspNetCore.Html.IHtmlContent BarRow(ReportScenarioRow scenario, string reportId, long scale)
    {
        var encoder = System.Text.Encodings.Web.HtmlEncoder.Default;
        var url = Url.ReportScenario(reportId, scenario.Guid);
        var name = scenario.TimingName;

        var href = url == null ? string.Empty : $" href=\"{encoder.Encode(url)}\"";
        var html = $"<a class=\"bar-row\"{href}>{scenario.Status.StatusIcon()}"
                   + $"<span class=\"strong\" style=\"min-width: 0; overflow-wrap: anywhere\">{encoder.Encode(name)}</span>"
                   + $"<span class=\"mono muted\" style=\"text-align: right\">{encoder.Encode(scenario.TimeTaken.ToShortDuration())}</span>"
                   + $"<span></span><span class=\"track\"><span style=\"width: {ReportUi.Percent(scenario.TimeTaken.Ticks, scale)}%\"></span></span><span></span></a>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
