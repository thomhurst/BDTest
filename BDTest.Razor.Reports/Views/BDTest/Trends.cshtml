@using System.Globalization
@using BDTest.Razor.Reports.Helpers
@using BDTest.Razor.Reports.Models
@using BDTest.Razor.Reports.Models.ViewModels
@using BDTest.Test
@model HistoryViewModel

@{
    ViewBag.Title = "History";
    Layout = "_Layout";

    var filter = Model.Filter;
    var runs = Model.Runs;
    var chartRuns = runs.TakeLast(60).ToList();
    var filterQuery = RunFilter.ToQueryString(filter.ToQuery(false));

    var passedRuns = runs.Count(run => run.RunResult() == Status.Passed);
    var rates = runs.Where(run => run.Counts.Total > 0).Select(run => (double)run.Counts.Passed / run.Counts.Total * 100).ToList();
    var durations = runs.Select(Duration).Where(duration => duration > TimeSpan.Zero).OrderBy(duration => duration).ToList();

    // Stacked from the bottom: passed, then the outcomes that need a look, with failures on top.
    var segments = new[]
    {
        (Status.Passed, "p"), (Status.Skipped, "s"), (Status.Pending, "r"), (Status.NotRun, "r"), (Status.Inconclusive, "i"), (Status.NotImplemented, "n"), (Status.Failed, "f")
    };
    var maxScenarios = Math.Max(1, chartRuns.Select(run => run.Counts.Total).DefaultIfEmpty(0).Max());
    var axisDates = AxisIndexes(chartRuns.Count).Select(index => chartRuns[index].StartedAtDateTime.ToDay()).ToList();

    var seconds = chartRuns.Select(run => Duration(run).TotalSeconds).ToList();
    var minSeconds = seconds.DefaultIfEmpty(0).Min();
    var maxSeconds = seconds.DefaultIfEmpty(0).Max();
    var padding = Math.Max((maxSeconds - minSeconds) * 0.15, Math.Max(maxSeconds * 0.05, 1));
    var lowSeconds = Math.Max(0, minSeconds - padding);
    var highSeconds = maxSeconds + padding;

    double X(int index) => chartRuns.Count == 1 ? 50 : index * 100.0 / (chartRuns.Count - 1);
    double Y(double value) => (highSeconds - value) / (highSeconds - lowSeconds) * 100;
    string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    string RunUrl(TestRunSummary run) => Url.Content("~/bdtest/report/" + Uri.EscapeDataString(run.RecordId ?? string.Empty) + "/summary");
}

@await Html.PartialAsync("_HistoryHeader", Model)

<main class="wrap page">
    @if (runs.Count == 0)
    {
        var anyTime = new RunFilter { Tag = filter.Tag, Environment = filter.Environment, Branch = filter.Branch, Machine = filter.Machine };
        var latest = anyTime.Apply(Model.AllRuns).OrderByDescending(run => run.StartedAtDateTime).FirstOrDefault();
        <section class="card empty">
            <span class="mark">@ReportUi.Icon("i-search", "xl")</span>
            <h2>No runs in this range</h2>
            <p>
                @if (Model.AllRuns.Count == 0)
                {
                    @:No test runs have been uploaded to this server yet.
                }
                else
                {
                    @:Nothing matches these filters in @(filter.CustomRange == null ? RunFilter.RangeLabel(filter.Range).ToLowerInvariant() : "the chosen dates").
                    @if (latest != null)
                    {
                        @:The latest matching run was on @latest.StartedAtDateTime.ToDay().
                    }
                }
            </p>
            <div class="cluster">
                @if (latest != null)
                {
                    <a class="btn pri" href="@(Url.Content("~/bdtest/report/history") + RunFilter.ToQueryString(anyTime.ToQuery(false)))">Show any time</a>
                }
                <a class="btn" href="@Url.Content("~/bdtest/report/history")">Reset filters</a>
            </div>
        </section>
    }
    else
    {
        <section class="card stats" aria-label="Summary for the range">
            <div class="stat"><span class="k">Runs that passed</span><b>@passedRuns of @runs.Count</b></div>
            <div class="stat"><span class="k">Average pass rate</span><b>@(rates.Count == 0 ? "—" : rates.Average().ToString("0.#", CultureInfo.CurrentCulture) + "%")</b></div>
            <div class="stat"><span class="k">Median duration</span><b>@(durations.Count == 0 ? "—" : durations[durations.Count / 2].ToShortDuration())</b></div>
            <div class="stat"><span class="k">Flaky scenarios</span><b><a class="lnk" href="@(Url.Content("~/bdtest/report/history/flaky") + filterQuery)">Find them</a></b></div>
        </section>

        <section class="card card-pad" aria-labelledby="results" style="gap: 14px">
            <div class="spread">
                <h2 id="results" style="font-size: 18px">Scenario results per run</h2>
                <div class="legend">
                    <span><i class="sw bg-f"></i>Failed</span>
                    <span><i class="sw bg-n"></i>Not implemented</span>
                    <span><i class="sw bg-i"></i>Inconclusive</span>
                    <span><i class="sw bg-r"></i>Pending / Not run</span>
                    <span><i class="sw bg-s"></i>Skipped</span>
                    <span><i class="sw bg-p"></i>Passed</span>
                </div>
            </div>
            <div class="chart" style="height: 240px">
                @foreach (var fraction in new[] { 1.0, 0.75, 0.5, 0.25, 0.0 })
                {
                    var top = F((1 - fraction) * 100);
                    <span class="grid-line @(fraction == 0 ? "base" : "")" style="top: @top%"></span>
                    <span class="ylab" style="top: @top%">@Math.Round(maxScenarios * fraction)</span>
                }
                <div class="plot bars cur-last">
                    @foreach (var run in chartRuns)
                    {
                        <a href="@RunUrl(run)" title="@BarLabel(run)" aria-label="@BarLabel(run)">
                            @foreach (var (status, key) in segments)
                            {
                                var count = Count(run, status);
                                if (count > 0)
                                {
                                    <span class="bg-@key" style="height: @F(count * 100.0 / maxScenarios)%"></span>
                                }
                            }
                        </a>
                    }
                </div>
            </div>
            <div class="xaxis">@foreach (var date in axisDates) { <span>@date</span> }</div>
        </section>

        <section class="card card-pad" aria-labelledby="durations" style="gap: 14px">
            <div class="spread">
                <h2 id="durations" style="font-size: 18px">Run duration</h2>
                <span class="small muted">Runs with failures are drawn as red squares</span>
            </div>
            <div class="chart" style="height: 200px">
                @foreach (var fraction in new[] { 1.0, 2.0 / 3, 1.0 / 3, 0.0 })
                {
                    var top = F((1 - fraction) * 100);
                    <span class="grid-line @(fraction == 0 ? "base" : "")" style="top: @top%"></span>
                    <span class="ylab" style="top: @top%">@TimeSpan.FromSeconds(lowSeconds + (highSeconds - lowSeconds) * fraction).ToShortDuration()</span>
                }
                <svg class="plot" viewBox="0 0 1000 200" preserveAspectRatio="none" role="img" style="width: calc(100% - 52px); height: 200px; overflow: visible"
                     aria-label="@($"Run duration over {chartRuns.Count} runs, from {TimeSpan.FromSeconds(minSeconds).ToShortDuration()} to {TimeSpan.FromSeconds(maxSeconds).ToShortDuration()}, latest {Duration(chartRuns[^1]).ToShortDuration()}")">
                    <polyline points="@string.Join(" ", seconds.Select((value, index) => F(X(index) * 10) + "," + F(Y(value) * 2)))" fill="none" stroke="var(--acc-fg)" stroke-width="2.25" vector-effect="non-scaling-stroke" stroke-linejoin="round"></polyline>
                </svg>
                <div class="plot" aria-hidden="true">
                    @for (var index = 0; index < chartRuns.Count; index++)
                    {
                        <a class="dot @(chartRuns[index].Counts.Failed > 0 ? "f" : "")" href="@RunUrl(chartRuns[index])" tabindex="-1" title="@chartRuns[index].StartedAtDateTime.ToRunDate() · @Duration(chartRuns[index]).ToShortDuration()" style="left: @F(X(index))%; top: @F(Y(seconds[index]))%"></a>
                    }
                </div>
            </div>
            <div class="xaxis">@foreach (var date in axisDates) { <span>@date</span> }</div>
        </section>

        <section class="card clip" aria-labelledby="table">
            <div class="card-head">
                <h2 id="table">Same data as a table</h2>
                <a class="lnk" href="@(Url.Content("~/bdtest/report/test-runs") + filterQuery)">All @runs.Count run@(runs.Count == 1 ? "" : "s")</a>
            </div>
            <div class="table-scroll">
                <table class="t">
                    <thead>
                    <tr>
                        <th scope="col">Run</th><th scope="col">Result</th><th scope="col" class="num">Failed</th>
                        <th scope="col" class="num">Other</th><th scope="col" class="num">Passed</th><th scope="col" class="num">Duration</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in runs.Reverse().Take(30))
                    {
                        var other = run.Counts.Total - run.Counts.Failed - run.Counts.Passed;
                        <tr>
                            <td style="white-space: nowrap"><a class="lnk" href="@RunUrl(run)">@run.StartedAtDateTime.ToRunDate(includeYear: false)</a></td>
                            <td>@run.RunResult().Pill()</td>
                            <td class="num">@run.Counts.Failed</td>
                            <td class="num">@other</td>
                            <td class="num">@run.Counts.Passed</td>
                            <td class="num">@Duration(run).ToShortDuration()</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>

@functions
{
    private static TimeSpan Duration(TestRunSummary run) =>
        run.FinishedAtDateTime > run.StartedAtDateTime ? run.FinishedAtDateTime - run.StartedAtDateTime : TimeSpan.Zero;

    private static int Count(TestRunSummary run, Status status) => status switch
    {
        Status.Passed => run.Counts.Passed,
        Status.Failed => run.Counts.Failed,
        Status.Skipped => run.Counts.Skipped,
        Status.Pending => run.Counts.Pending,
        Status.Inconclusive => run.Counts.Inconclusive,
        Status.NotImplemented => run.Counts.NotImplemented,
        // Counts.NotRun also includes declared tests; Total counts only scenarios.
        Status.NotRun => Math.Max(0, run.Counts.Total - run.Counts.Passed - run.Counts.Failed - run.Counts.Skipped
            - run.Counts.Pending - run.Counts.Inconclusive - run.Counts.NotImplemented),
        _ => 0
    };

    private static string BarLabel(TestRunSummary run) =>
        $"{run.StartedAtDateTime.ToRunDate()}: {run.Counts.Failed} failed, {run.Counts.Passed} passed";

    // Up to five evenly spaced positions for date labels, always including the first and last run.
    private static IEnumerable<int> AxisIndexes(int count)
    {
        if (count == 0)
        {
            return Enumerable.Empty<int>();
        }

        var labels = Math.Min(5, count);
        return Enumerable.Range(0, labels)
            .Select(index => labels == 1 ? 0 : (int)Math.Round(index * (count - 1) / (double)(labels - 1)))
            .Distinct();
    }
}
