@using BDTest.Razor.Reports.Constants
@using BDTest.Razor.Reports.Helpers
@model BDTest.Razor.Reports.Models.PaginationInformation

@if (Model.TotalPages <= 1 && Model.TotalItems == 0)
{
    return;
}

@{
    var showingAll = string.Equals(Context.GetCurrentPageNumber(), PagerQueryParameters.All, StringComparison.OrdinalIgnoreCase);
    var hasPrevious = !showingAll && Model.CurrentPage > Model.StartPage;
    var hasNext = !showingAll && Model.CurrentPage < Model.EndPage;
}

<nav class="pager" aria-label="Pagination">
    @if (Model.TotalItems > 0)
    {
        <span>@($"{Model.StartIndex + 1}–{Model.EndIndex + 1} of {Model.TotalItems} {Model.ItemName}")</span>
    }
    <span class="grow"></span>
    @if (Model.PageSizeOptions.Length > 0)
    {
        <form method="get" action="@Context.Request.PathBase.Add(Context.Request.Path).ToUriComponent()" data-autosubmit>
            @foreach (var parameter in Context.Request.Query)
            {
                if (string.Equals(parameter.Key, PagerQueryParameters.Page, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(parameter.Key, "perPage", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }
                foreach (var value in parameter.Value)
                {
                    <input type="hidden" name="@parameter.Key" value="@value" />
                }
            }
            <label class="inline-field">Per page
                <select class="inp" name="perPage" style="min-height: 32px">
                    @foreach (var size in Model.PageSizeOptions)
                    {
                        <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                    }
                </select>
            </label>
            <noscript><button class="btn sm" type="submit">Apply</button></noscript>
        </form>
    }
    @if (Model.TotalPages > 1)
    {
        @if (hasPrevious)
        {
            <a class="btn sm" href="@Context.GetUrlForPageNumber(Model.CurrentPage - 1)">@ReportUi.Icon("i-chev-l")@Model.PreviousText</a>
        }
        else
        {
            <span class="btn sm" aria-disabled="true">@ReportUi.Icon("i-chev-l")@Model.PreviousText</span>
        }
        @if (hasNext)
        {
            <a class="btn sm" href="@Context.GetUrlForPageNumber(Model.CurrentPage + 1)">@Model.NextText@(ReportUi.Icon("i-chev-r"))</a>
        }
        else
        {
            <span class="btn sm" aria-disabled="true">@Model.NextText@(ReportUi.Icon("i-chev-r"))</span>
        }
        @if (!showingAll)
        {
            <a class="btn ghost sm link" href="@Context.GetLocalUrlWithQueryParameter(PagerQueryParameters.Page, PagerQueryParameters.All)">Show all</a>
        }
    }
</nav>
