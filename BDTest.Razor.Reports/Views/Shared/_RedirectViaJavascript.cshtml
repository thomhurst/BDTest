@using BDTest.Razor.Reports.Helpers
@model BDTest.Razor.Reports.Views.BDTest.RedirectViaJavascriptViewModel

@{
    var urlToRedirect = Context.GetLocalUrl(Context.Request.Path.Value.Replace(Model.FromPath, Model.ToPath));
}

<script>
    window.location.href = @Json.Serialize(urlToRedirect);
</script>